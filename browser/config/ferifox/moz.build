# Packaged so FerifoxConfig can fall back to the platform default persona
# when FERIFOX_CONFIG is not set, and so launchers can reference the
# checked-in personas next to the binary.
FINAL_TARGET_FILES.personas += [
    "personas/linux-firefox.json",
    "personas/linux-headless-firefox.json",
    "personas/linux-hidpi-firefox.json",
    "personas/macos-firefox.json",
    "personas/win10-firefox.json",
    "personas/win11-cn-firefox.json",
    "personas/win11-firefox.json",
]
