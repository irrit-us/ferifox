with Files("**"):
    BUG_COMPONENT = ("Core", "General")

UNIFIED_SOURCES += [
    "FerifoxConfig.cpp",
    "FerifoxTestUtils.cpp",
]

LOCAL_INCLUDES += [
    "/toolkit/components/jsoncpp/include",
]

EXPORTS += [
    "FerifoxTestUtils.h",
]

EXPORTS.mozilla += [
    "FerifoxConfig.h",
    "FerifoxTestUtils.h",
]

XPIDL_SOURCES += [
    "nsIFerifoxTestUtils.idl",
]

XPCOM_MANIFESTS += [
    "components.conf",
]

XPIDL_MODULE = "ferifox"

FINAL_LIBRARY = "xul"

USE_LIBS += [
    "jsoncpp",
]
